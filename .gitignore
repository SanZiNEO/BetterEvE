.vscode/
*.code-workspace

# Eclipse
.settings/
.classpath
.project
bin/

# NetBeans
nbproject/
nbactions.xml

# ========== 操作系统文件 ==========

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

